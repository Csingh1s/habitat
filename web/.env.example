# Public production build configuration. Development uses the local Vite API proxy.
VITE_API_BASE_URL=https://YOUR_API_HOST
VITE_ENTRA_CLIENT_ID=YOUR_WEB_APPLICATION_ID
VITE_ENTRA_AUTHORITY=https://YOUR_TENANT.ciamlogin.com/YOUR_TENANT.onmicrosoft.com
VITE_ENTRA_API_SCOPE=api://YOUR_API_APPLICATION_ID/access_as_user
# Register the deployed web origin as an Entra SPA redirect URI.
# Never put Supabase service-role, model-provider, or other secrets in VITE variables.