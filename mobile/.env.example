# Android emulator: 10.0.2.2 points to the computer running FastAPI.
EXPO_PUBLIC_HABITAT_API_BASE_URL=http://10.0.2.2:8001
EXPO_PUBLIC_HABITAT_API_MODE=development

# Browser development uses http://127.0.0.1:8001 instead of the Android address.
# Deployed builds use HTTPS and never development identity headers.
# EXPO_PUBLIC_HABITAT_API_BASE_URL=https://YOUR_API_HOST
# EXPO_PUBLIC_HABITAT_API_MODE=deployed
# EXPO_PUBLIC_ENTRA_CLIENT_ID=YOUR_MOBILE_APPLICATION_ID
# EXPO_PUBLIC_ENTRA_ISSUER_URL=https://YOUR_TENANT.ciamlogin.com/YOUR_TENANT.onmicrosoft.com/v2.0
# EXPO_PUBLIC_ENTRA_API_SCOPE=api://YOUR_API_APPLICATION_ID/access_as_user
# These are public registration values. Never place server credentials here.
