# Local development intentionally blocks every remote inference request.
APP_ENV=development
ENABLE_REMOTE_INFERENCE=false
PERSISTENCE_BACKEND=memory
INFERENCE_EXECUTION_MODE=background

# Select "qwen_cloud" only in a deployed production FastAPI service.
INFERENCE_PROVIDER=qwen_cloud
QWEN_CLOUD_INFERENCE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1/chat/completions
QWEN_CLOUD_MODEL_ID=qwen3.7-flash
QWEN_CLOUD_MODEL_VERSION=qwen-cloud-managed

# Set DASHSCOPE_API_KEY only in your deployment secret manager or ignored local .env file.
# Never commit or paste the API key.
# DASHSCOPE_API_KEY=

# Staging/production only: use a server-side Azure secret, never a mobile-app variable.
# PERSISTENCE_BACKEND=supabase
# INFERENCE_EXECUTION_MODE=worker
# CLAMAV_HOST=private-scanner-hostname
# CLAMAV_PORT=3310
# DEPLOYED_CORS_ORIGINS=["https://YOUR_WEB_HOST"]
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=inspection-evidence
# OIDC_ISSUER_URL=https://YOUR_TENANT.ciamlogin.com/YOUR_TENANT.onmicrosoft.com/v2.0
# OIDC_AUDIENCE=api://YOUR_ENTRA_API_APPLICATION_ID
# OIDC_JWKS_URL=https://YOUR_TENANT.ciamlogin.com/YOUR_TENANT.onmicrosoft.com/discovery/v2.0/keys

# Run a separate continuously available worker with the same server configuration:
# python -m habitat_api.worker
# Apply every Supabase migration before starting deployed API and worker processes.
